{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist-electron",
    "target": "ES2020",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "electron/**/*",
    "src/overlay/detail-level.ts",
    "src/lib/upcoming-select.ts",
    "src/lib/game-status-normalize.ts",
    "src/lib/title-collator.ts",
    "src/data/gaming-events.ts",
    "src/lib/chat-providers.ts",
    "src/lib/candidate-selector.ts",
    "package.json"
  ]
}

